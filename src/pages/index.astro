---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    number: '01',
    title: 'Frontend / Web',
    text: 'Webs rápidas, claras y listas para convertir visitas en conversaciones.',
    className: 'card-cyan',
    icon: 'brackets',
  },
  {
    number: '02',
    title: 'Apps móviles',
    text: 'Productos móviles que se sienten simples desde el primer toque.',
    className: 'card-pink',
    icon: 'phone',
  },
  {
    number: '03',
    title: 'Tech / UI-UX',
    text: 'Ordeno ideas complejas y las convierto en experiencias que la gente entiende.',
    className: 'card-green',
    icon: 'spark',
  },
];

const projects = [
  {
    index: '01 / 02',
    title: 'Marea Studio',
    type: 'Sitio editorial + e-commerce',
    challenge: 'El estudio tenía una historia potente, pero su web la escondía detrás de demasiadas capas.',
    solution: 'Rediseñé el recorrido, construí una identidad más frontal y dejé cada producto a un clic.',
    tags: ['Astro', 'Shopify', 'Figma'],
    className: 'project-yellow',
  },
  {
    index: '02 / 02',
    title: 'Ruta Norte',
    type: 'App de operaciones',
    challenge: 'Un equipo de campo necesitaba tomar decisiones sin pelearse con una pantalla llena de datos.',
    solution: 'Convertí el ruido en un panel móvil de acciones rápidas, estados claros y cero pasos de más.',
    tags: ['React Native', 'Node.js', 'UX'],
    className: 'project-cyan',
  },
];

const testimonials = [
  { quote: 'Isaac entendió el problema antes de abrir Figma. El resultado se siente nuestro.', name: 'Laura Méndez', role: 'Fundadora, Marea Studio' },
  { quote: 'Pasamos de explicar la idea con diez diapositivas a enseñarla en una sola pantalla.', name: 'Diego Ríos', role: 'Product lead, Ruta Norte' },
  { quote: 'Código limpio, comunicación directa y una web que por fin vende lo que hacemos.', name: 'Ana Torres', role: 'Directora, Estudio Cero' },
];

const technologies = ['ASTRO', 'REACT', 'FIGMA', 'NODE.JS', 'TYPESCRIPT', 'CSS', 'UX/UI'];
---

<BaseLayout>
  <header class="site-header">
    <nav class="nav container" aria-label="Navegación principal">
      <a class="brand" href="#inicio" aria-label="Isaac Castillo Freelance, inicio">
        <span>ISAAC</span><span class="brand-slash">/</span><span>CASTILLO</span>
      </a>
      <div class="nav-links">
        <a href="#servicios">Servicios</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#sobre-mi">Sobre mí</a>
      </div>
      <a class="brutal-button button-yellow nav-cta" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="contenido">
    <section class="hero section" id="inicio">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Disponible para proyectos · 2026</p>
          <h1>Webs que no aburren<span class="accent-mark">.</span><br />Apps que sí venden<span class="accent-mark">.</span></h1>
          <p class="hero-lede">Soy Isaac, desarrollador freelance. Construyo productos digitales rápidos, claros y con personalidad para equipos que quieren moverse.</p>
          <div class="hero-actions">
            <a class="brutal-button button-yellow" href="#proyectos">Ver proyectos <span aria-hidden="true">↓</span></a>
            <a class="brutal-button button-dark" href="#contacto">Agenda una llamada <span aria-hidden="true">↗</span></a>
          </div>
          <p class="hero-note mono">// Código limpio. Entregas a tiempo.</p>
        </div>

        <div class="hero-art" aria-label="Composición abstracta con bloques de color" role="img">
          <div class="art-topline mono">IC / 001 <span>BUILD LOUD</span></div>
          <div class="art-sun"></div>
          <div class="art-cross cross-one">+</div>
          <div class="art-cross cross-two">+</div>
          <div class="art-frame">
            <div class="art-face" aria-hidden="true">
              <span class="face-eye eye-left"></span><span class="face-eye eye-right"></span>
              <span class="face-mouth"></span>
            </div>
            <span class="art-label mono">DESIGN<br />&amp; CODE</span>
          </div>
          <div class="art-sticker">NO<br />BORING<br />SITES</div>
          <div class="art-bottom mono">01 — 2026 / MAKE IT USEFUL</div>
        </div>
      </div>
    </section>

    <section class="ticker" aria-label="Tecnologías que domino">
      <div class="ticker-track">
        {[...technologies, ...technologies].map((technology) => <span>{technology}<b aria-hidden="true">✳</b></span>)}
      </div>
    </section>

    <section class="section services" id="servicios">
      <div class="container">
        <div class="section-intro split-intro">
          <div><p class="eyebrow">01 / Qué hago</p><h2>Menos humo.<br /><em>Más producto.</em></h2></div>
          <p class="section-lede">No vendo “soluciones integrales”. Me meto en el problema, lo ordeno y construyo lo que hace falta para que avances.</p>
        </div>
        <div class="services-grid">
          {services.map((service) => (
            <article class={`brutal-card service-card ${service.className}`}>
              <div class="card-topline"><span class="mono">{service.number}</span><span class="card-icon" aria-hidden="true">
                {service.icon === 'brackets' && <><span>&lt;</span><span>/&gt;</span></>}
                {service.icon === 'phone' && <span class="phone-icon"></span>}
                {service.icon === 'spark' && <span class="spark-icon">✦</span>}
              </span></div>
              <h3>{service.title}</h3><p>{service.text}</p><a class="text-link" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section portfolio" id="proyectos">
      <div class="container">
        <div class="section-intro split-intro">
          <div><p class="eyebrow">02 / Trabajo reciente</p><h2>Hecho para<br /><em>ser usado.</em></h2></div>
          <p class="section-lede">Cada proyecto empieza con una pregunta incómoda: ¿qué tiene que pasar para que esto sea realmente útil?</p>
        </div>
        <div class="projects-list">
          {projects.map((project, index) => (
            <article class={`project brutal-card ${project.className} ${index % 2 === 1 ? 'project-reverse' : ''}`}>
              <div class="project-visual" aria-hidden="true">
                <div class="browser-bar"><i></i><i></i><i></i><span class="mono">{project.title.toUpperCase()}.COM</span></div>
                <div class="project-screen"><span class="screen-word">{index === 0 ? 'MAREA' : 'RUTA'}</span><span class="screen-line"></span><span class="screen-box"></span></div>
                <span class="project-stamp mono">CASE / {project.index}</span>
              </div>
              <div class="project-copy"><p class="mono project-index">{project.index} · {project.type}</p><h3>{project.title}</h3><div class="tag-row">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div><p><strong>El reto:</strong> {project.challenge}</p><p><strong>La solución:</strong> {project.solution}</p><a class="brutal-button button-dark small-button" href="#contacto">Ver caso de estudio <span aria-hidden="true">↗</span></a></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section proof">
      <div class="container">
        <div class="section-intro"><p class="eyebrow">03 / Gente real</p><h2>Buenas palabras.<br /><em>Mejor trabajo.</em></h2></div>
        <div class="testimonials-grid">
          {testimonials.map((testimonial, index) => <figure class={`testimonial brutal-card ${index === 1 ? 'card-yellow' : 'card-paper'}`}><div class="stars" aria-label="5 de 5 estrellas">★★★★★</div><blockquote>“{testimonial.quote}”</blockquote><figcaption><span class="avatar">{testimonial.name.split(' ').map((name) => name[0]).join('')}</span><span><strong>{testimonial.name}</strong><small>{testimonial.role}</small></span></figcaption></figure>)}
        </div>
      </div>
    </section>

    <section class="section about" id="sobre-mi">
      <div class="container about-grid">
        <div><p class="eyebrow">04 / Sobre mí</p><h2>Hola, soy<br /><em>Isaac.</em></h2><div class="about-number">13<span>+</span></div><p class="mono about-number-label">proyectos enviados<br />al mundo</p></div>
        <div class="about-copy"><p class="about-lede">Me gusta el código que se puede explicar y el diseño que no necesita explicación.</p><p>Trabajo con startups y equipos pequeños que necesitan convertir una idea en algo que la gente pueda usar, entender y recomendar. Sin reuniones que pudieron ser un email. Sin pantallas bonitas que no hacen nada.</p><div class="principles"><span><b>01</b> Preguntar antes de construir</span><span><b>02</b> Hacerlo simple, no básico</span><span><b>03</b> Dejar el código mejor de como lo encontré</span></div><p class="coffee-note">Sobrevivo a base de café y CSS <span aria-hidden="true">✦</span></p></div>
      </div>
    </section>
  </main>

  <footer class="contact" id="contacto">
    <div class="container">
      <div class="contact-heading"><p class="eyebrow">05 / Siguiente paso</p><h2>¿Listo para llevar<br />tu idea a producción<span class="accent-mark">?</span></h2></div>
      <div class="contact-grid">
        <form class="contact-form" action="#contacto" method="post">
          <label for="name">Tu nombre<input id="name" name="name" type="text" placeholder="Isaac, hola" /></label>
          <label for="email">Tu email<input id="email" name="email" type="email" placeholder="hola@tuempresa.com" /></label>
          <label for="message">¿Qué estás construyendo?<textarea id="message" name="message" rows="4" placeholder="Cuéntame lo importante..."></textarea></label>
          <button class="brutal-button button-dark submit-button" type="submit">Enviar mensaje <span aria-hidden="true">↗</span></button>
        </form>
        <div class="contact-links"><p class="mono">O escríbeme directo</p><a class="email-link" href="mailto:hola@isaaccastillo.dev">hola@isaaccastillo.dev <span aria-hidden="true">↗</span></a><div class="social-links"><a href="https://www.linkedin.com" rel="noreferrer">LinkedIn ↗</a><a href="https://github.com" rel="noreferrer">GitHub ↗</a></div><p class="footer-mark">ISAAC<br /><span>CASTILLO</span><br />/ FREELANCE</p></div>
      </div>
      <div class="footer-bottom mono"><span>© 2026 Isaac Castillo</span><span>Hecho con intención / Panamá</span><a href="#inicio">Volver arriba ↑</a></div>
    </div>
  </footer>
</BaseLayout>
